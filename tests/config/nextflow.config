params.modules_testdata_base_path = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/"

nextflow.enable.moduleBinaries = true

docker.enabled = true

aws {
    region = "eu-west-2"
    client {
        endpoint = "https://cog.sanger.ac.uk"
        anonymous = true
        s3PathStyleAccess = true
    }
}
