includeConfig "../../../../tests/config/nextflow.config"

process {
    withName: PHENIXICECHUNK {
        ext.args = { params.stitch_3d ? '--flatfield' : '--flatfield --zproject max --ome-tiff .' }
    }
    withName: MULTIVIEWSTITCHER {
        ext.args = { "--projection none --wells ${meta.well}" }
    }
}

// The images run as root, which would leave root-owned files in the nf-test work directory
docker.runOptions = '-u $(id -u):$(id -g)'

// nf-core modules name biocontainers images without a registry, as nf-core pipelines set it
docker.registry = 'quay.io'
