// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core subworkflows test preprocess_ome_zarr_tiles
nextflow_workflow {

    name "Test Subworkflow PREPROCESS_OME_ZARR_TILES"
    script "../main.nf"
    workflow "PREPROCESS_OME_ZARR_TILES"

    tag "subworkflows"
    tag "subworkflows_sangercellgeni"
    tag "subworkflows/preprocess_ome_zarr_tiles"
    tag "bioformats2rawcompanion"
    tag "imaging/generatecompanion"
    tag "omezarr/createemptycontainer"
    tag "omezarr/preprocess"
    tag "omezarr/validate"


    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("sarscov2 - bam - single_end") {

        when {
            workflow {
                """
                // TODO nf-core: define inputs of the workflow here. Example:
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                ]
                input[1] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                ]
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out
                    //TODO nf-core: Add all required assertions to verify the test output.
                ).match() }
            )
        }
    }
}
