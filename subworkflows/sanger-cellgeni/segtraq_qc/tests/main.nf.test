nextflow_workflow {

    name "Test Subworkflow SEGTRAQ_QC"
    script "../main.nf"
    workflow "SEGTRAQ_QC"

    tag "subworkflows"
    tag "subworkflows_sanger-cellgeni"
    tag "subworkflows_sangercellgeni"
    tag "subworkflows/segtraq_qc"
    tag "segtraq/baseline"
    tag "segtraq/clusteringstability"
    tag "segtraq/regionsimilarity"
    tag "segtraq/volume"

    test("segtraq_qc - xenium zarr - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = [
                    [ id:'test_xenium' ],
                    file(params.modules_testdata_base_path + 'segtraq/xenium.zarr', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

}
