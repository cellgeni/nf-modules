    //             { assert snapshot(workflow.out).match()}
    //         )
    //     }
    // }

    test("nichecompass concatenated - mouse - 3") {

        when {
            params {
                modules_testdata_base_path  = 's3://spatial_demo_datasets/'
                nichecompass_preprocess_args = '--species mouse'
                nichecompass_train_args      = '--use_cuda_if_available false'
            }
            workflow {
                """
                input[0] = [
                    [ id:'test_20250830' ], // meta map
                    file(params.modules_testdata_base_path + 'nichecompass/training/100_concat/*.h5ad', checkIfExists: true),
                    'batch'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out).match()}
            )
        }
    }
}
