nextflow_process {

    name "Test Process DOTPY"
    script "../main.nf"
    process "DOTPY"
    config "./nextflow.config"

    tag "modules"
    tag "modules_sanger-cellgeni"
    tag "modules_sangercellgeni"
    tag "dotpy"

    test("dotpy - h5ad") {

        when {
            params {
                module_args = "--cell-type-key identities"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${new File('modules/sanger-cellgeni/dotpy/tests/sc_reference.h5ad').absolutePath}", checkIfExists: true),
                    file("${new File('modules/sanger-cellgeni/dotpy/tests/sp_data.h5ad').absolutePath}", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.weights[0][1].toString().endsWith('test_all_weights.csv') },
                { assert process.out.annotations[0][1].toString().endsWith('test_all_annotations.csv') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("dotpy - h5ad - stub") {

        options "-stub"

        when {
            params {
                module_args = "--cell-type-key identities"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${new File('modules/sanger-cellgeni/dotpy/tests/sc_reference.h5ad').absolutePath}", checkIfExists: true),
                    file("${new File('modules/sanger-cellgeni/dotpy/tests/sp_data.h5ad').absolutePath}", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
