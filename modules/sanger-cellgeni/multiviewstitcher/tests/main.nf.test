nextflow_process {

    name "Test Process MULTIVIEWSTITCHER"
    script "../main.nf"
    process "MULTIVIEWSTITCHER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "multiviewstitcher"

    // Stub test only: the input is a phenix-icechunk repo whose virtual chunks point at the
    // Harmony TIFFs by absolute path, so there is no small, self-contained test dataset yet.

    test("phenix icechunk - single well - stub") {

        options "-stub"

        when {
            params {
                module_args = "--wells A1 --projection max"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('.')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
