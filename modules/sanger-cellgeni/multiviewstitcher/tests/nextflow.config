includeConfig "../../../../tests/config/nextflow.config"

process {
    withName: MULTIVIEWSTITCHER {
        ext.args = params.module_args
    }
}

// The image runs as root, which would leave root-owned files in the nf-test work
// directory and break subsequent runs. stitch_wells.py needs no root privileges, so drop them.
docker.runOptions = '-u $(id -u):$(id -g)'
