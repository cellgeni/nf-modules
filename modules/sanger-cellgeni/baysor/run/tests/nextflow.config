includeConfig "../../../../../tests/config/nextflow.config"

// The baysor image runs as root, which would leave root-owned files in the nf-test work
// directory and break subsequent runs. Baysor needs no root privileges, so drop them.
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: BAYSOR_RUN {
        ext.args = params.module_args
        ext.prior = params.module_prior
    }
}
