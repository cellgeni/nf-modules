nextflow_process {

    name "Test Process NICHECOMPASS_TRAIN"
    script "../main.nf"
    process "NICHECOMPASS_TRAIN"

    tag "modules"
    tag "modules_sanger-cellgeni"
    tag "nichecompass"
    tag "nichecompass/train"

    test("nichecompass_train - preprocessed h5ad") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_20250829' ],
                    file(params.modules_testdata_base_path + 'nichecompass/preprocess/test_20250829_preprocessed.h5ad', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'nichecompass/preprocess/data', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("nichecompass_train - preprocessed h5ad - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_20250829' ],
                    file(params.modules_testdata_base_path + 'nichecompass/preprocess/test_20250829_preprocessed.h5ad', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'nichecompass/preprocess/data', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
