process {
    withName: NICHECOMPASS_PREPROCESS {
        singularity.runOptions = "-H /tmp --cleanenv --containall"
        // The following ext.args are mandatory — set them per run in your pipeline's modules.config:
        //   --cell_type_key <obs column for cell-type labels>
        //   --sample_key    <obs column for sample/batch identity>
        //   --counts_key    <layers key for raw counts>
        //   --spatial_key   <obsm key for 2-D spatial coordinates>
        // These values are propagated automatically to the train step via adata.uns.
    }
}
