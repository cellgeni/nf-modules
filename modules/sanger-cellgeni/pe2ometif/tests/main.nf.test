nextflow_process {

    name "Test Process PE2OMETIF"
    script "../main.nf"
    process "PE2OMETIF"
    config "./nextflow.config"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "pe2ometif"

    test("pe2ometif - perkinelmer full run") {

        when {
            params {
                module_args = ""
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('s3://spatial_demo_datasets/PerkinElmer/Hoechst__2023-03-07T10_17_54-Measurement 2/Images/', checkIfExists: true),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tif[0][1].size() > 0 },
                { assert process.out.master_companion[0][1].toString().endsWith('.companion.ome') },
                { assert process.out.versions_pe2ometif[0][1] == 'pe2ometif' },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("pe2ometif - no companion stub") {

        options "-stub"

        when {
            params {
                module_args = "--no-companion"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('.'),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tif[0][1].toString().endsWith('A01_F001_maxproj.ome.tif') },
                { assert process.out.master_companion[0][1].toString().endsWith('.companion.ome') },
                { assert snapshot(process.out).match() }
            )
        }

    }

    // -----------------------------------------------------------------------
    // Row / column range filtering — real data (single well C07 in the S3 dataset)
    // -----------------------------------------------------------------------

    test("pe2ometif - row range matching well") {

        // The S3 dataset contains only well C07 (row=3 → letter C).
        // --row-range C should include it and produce exactly one OME-TIFF.

        when {
            params {
                module_args = "--row-range C"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('s3://spatial_demo_datasets/PerkinElmer/Hoechst__2023-03-07T10_17_54-Measurement 2/Images/', checkIfExists: true),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tif[0][1].size() > 0 },
                { assert process.out.ome_tif[0][1].toString().contains('C07') },
                { assert process.out.master_companion[0][1].toString().endsWith('.companion.ome') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("pe2ometif - col range matching well") {

        // Well C07 is in column 7. --col-range 7 should include it.

        when {
            params {
                module_args = "--col-range 7"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('s3://spatial_demo_datasets/PerkinElmer/Hoechst__2023-03-07T10_17_54-Measurement 2/Images/', checkIfExists: true),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tif[0][1].size() > 0 },
                { assert process.out.ome_tif[0][1].toString().contains('C07') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("pe2ometif - row and col range matching well") {

        // Both filters applied together; the intersection still includes C07.

        when {
            params {
                module_args = "--row-range C --col-range 7"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('s3://spatial_demo_datasets/PerkinElmer/Hoechst__2023-03-07T10_17_54-Measurement 2/Images/', checkIfExists: true),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tif[0][1].size() > 0 },
                { assert process.out.ome_tif[0][1].toString().contains('C07') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("pe2ometif - row range excluding well fails") {

        // Rows A-B do not contain C07; the script calls sys.exit() → process must fail.

        when {
            params {
                module_args = "--row-range A-B"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('s3://spatial_demo_datasets/PerkinElmer/Hoechst__2023-03-07T10_17_54-Measurement 2/Images/', checkIfExists: true),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assert !process.success
        }
    }

    test("pe2ometif - col range excluding well fails") {

        // Columns 1-6 do not contain C07 (which is column 7).

        when {
            params {
                module_args = "--col-range 1-6"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('s3://spatial_demo_datasets/PerkinElmer/Hoechst__2023-03-07T10_17_54-Measurement 2/Images/', checkIfExists: true),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assert !process.success
        }
    }

    // -----------------------------------------------------------------------
    // Row / column range filtering — stub mode (validates arg wiring only)
    // -----------------------------------------------------------------------

    test("pe2ometif - row range stub") {

        options "-stub"

        when {
            params {
                module_args = "--row-range B-D"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('.'),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tif[0][1].toString().endsWith('A01_F001_maxproj.ome.tif') },
                { assert process.out.master_companion[0][1].toString().endsWith('.companion.ome') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("pe2ometif - col range stub") {

        options "-stub"

        when {
            params {
                module_args = "--col-range 4-6"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('.'),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tif[0][1].toString().endsWith('A01_F001_maxproj.ome.tif') },
                { assert process.out.master_companion[0][1].toString().endsWith('.companion.ome') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("pe2ometif - row and col range stub") {

        options "-stub"

        when {
            params {
                module_args = "--row-range B-D --col-range 4-6"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('.'),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.ome_tif[0][1].toString().endsWith('A01_F001_maxproj.ome.tif') },
                { assert process.out.master_companion[0][1].toString().endsWith('.companion.ome') },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
