nextflow_process {

    name "Test Process ML_SEGMENTATIONCELLTILES"
    script "../main.nf"
    config "./nextflow.config"
    process "ML_SEGMENTATIONCELLTILES"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "ml"
    tag "ml/segmentationcelltiles"

    
    test("segmentationcelltiles - test") {

        when {
            process {
                """
                input[0] = [
                    'segmentationcelltiles_test', // meta map
                    '/lustre/scratch127/cellgen/cellgeni/dn10/output_file1'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
                
            )
        }

    }

    test("segmentationcelltiles - test - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'segmentationcelltiles_test', // meta map
                    '/lustre/scratch127/cellgen/cellgeni/dn10/output_file1'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
                
            )
        }

    }

}
