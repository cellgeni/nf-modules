nextflow_process {

    name "Test Process ML_SEGMENTATIONCELLVECTORFIELDTILES"
    script "../main.nf"
    config "./nextflow.config"
    process "ML_SEGMENTATIONCELLVECTORFIELDTILES"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "ml"
    tag "ml/segmentationcellvectorfieldtiles"

    
    test("segmentationcellvectorfieldtiles - test") {


        when {
            process {
                """
                input[0] = [
                    'segmentationcellvectorfieldtiles_test', // meta map
                    '/lustre/scratch127/cellgen/cellgeni/dn10/nf-modules/modules/sanger-cellgeni/ml/xeniumharmonise/.nf-test/tests/d079905b5f961596112fb2504e837418/results/xeniumharmonise_test_harmonised'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
                
            )
        }

    }

    test("segmentationcellvectorfieldtiles - test - stub") {

        options "-stub"

        when {
            process {
                """
                
                input[0] = [
                    'segmentationcellvectorfieldtiles_test', // meta map
                    '/lustre/scratch127/cellgen/cellgeni/dn10/nf-modules/modules/sanger-cellgeni/ml/xeniumharmonise/.nf-test/tests/d079905b5f961596112fb2504e837418/results/xeniumharmonise_test_harmonised'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
