process {
    withName: 'ML_SEGMENTATIONCELLVECTORFIELDTILES' {
        queue          = 'normal'
        group          = 'cellgeni'
        cpus           = 1
        clusterOptions = '-M 8G -R "select[mem>8G] rusage[mem=8G]"'
        container      = '/lustre/scratch127/cellgen/cellgeni/dn10/feature_extraction_morphology/feature_extraction.sif'
        publishDir     = 'results'
    }
}