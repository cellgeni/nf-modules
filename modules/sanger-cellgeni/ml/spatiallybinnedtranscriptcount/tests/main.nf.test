
nextflow_process {

    name "Test Process ML_SPATIALLYBINNEDTRANSCRIPTCOUNT"
    script "../main.nf"
    config "./nextflow.config"
    process "ML_SPATIALLYBINNEDTRANSCRIPTCOUNT"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "ml"
    tag "ml/spatiallybinnedtranscriptcount"


    test("spatiallybinnedtranscriptcount - test") {


        when {
            process {
                """
                
                input[0] = [
                    'spatiallybinnedtranscriptcount_test', // meta map
                    '/lustre/scratch127/cellgen/cellgeni/dn10/nf-modules/modules/sanger-cellgeni/ml/xeniumharmonise/.nf-test/tests/d079905b5f961596112fb2504e837418/results/xeniumharmonise_test_harmonised'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
               
            )
        }

    }

    test("spatiallybinnedtranscriptcount - test - stub") {

        options "-stub"

        when {
            process {
                """
                
                input[0] = [
                    'spatiallybinnedtranscriptcount_test', // meta map
                    '/lustre/scratch127/cellgen/cellgeni/dn10/nf-modules/modules/sanger-cellgeni/ml/xeniumharmonise/.nf-test/tests/d079905b5f961596112fb2504e837418/results/xeniumharmonise_test_harmonised'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
                //TODO nf-core: Add all required assertions to verify the test output.
            )
        }

    }

}
