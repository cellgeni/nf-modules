nextflow_process {

    name "Test Process OMEZARR_VALIDATE"
    script "../main.nf"
    process "OMEZARR_VALIDATE"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "omezarr"
    tag "omezarr/validate"

    test("omezarr validate - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    "${outputDir}/test.ome.zarr",
                    '[["image_0", "A/1/0"]]',
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert process.out.versions_omezarr_validate[0][1] == 'omezarr_validate' },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
