nextflow_process {

    name "Test Process TACCO_ANNOTATE"
    script "../main.nf"
    process "TACCO_ANNOTATE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "tacco"
    tag "tacco/annotate"

    // tests/data: synthetic counts. reference.h5ad: 120 cells x 60 genes, 3 cell types
    // (.obs cell_type) with 15 marker genes each. spatial.h5ad: 90 cells (30 per type, true type
    // in .obs truth) measured on a 45-gene subset, with lower depth; counts also in layers['counts'].

    test("OT - spatial vs reference") {

        when {
            params {
                module_args = "--annotation-key cell_type"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/spatial.h5ad", checkIfExists: true),
                    file("${moduleDir}/tests/data/reference.h5ad", checkIfExists: true),
                ]
                """
            }
        }

        then {
            def lines = path(process.out.annotation[0][1]).linesGzip
            def header = lines[0].split(',') as List
            def top = lines[1..-1].collect { it.split(',')[header.indexOf('cell_type')] }
            assertAll(
                { assert process.success },
                // spatial.h5ad cells are ordered 30 T_cell, 30 B_cell, 30 Fibroblast
                { assert top == ['T_cell'] * 30 + ['B_cell'] * 30 + ['Fibroblast'] * 30 },
                { assert snapshot(
                    header,
                    lines.size(),
                    file(process.out.h5ad[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') },
                ).match() }
            )
        }
    }

    test("nnls - counts layer, custom result key") {

        when {
            params {
                module_args = "--annotation-key cell_type --method nnls --spatial-layer counts --result-key tacco_ct"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/spatial.h5ad", checkIfExists: true),
                    file("${moduleDir}/tests/data/reference.h5ad", checkIfExists: true),
                ]
                """
            }
        }

        then {
            def lines = path(process.out.annotation[0][1]).linesGzip
            assertAll(
                { assert process.success },
                { assert snapshot(
                    lines[0],
                    lines.size(),
                ).match() }
            )
        }
    }

    test("OT - stub") {

        options "-stub"

        when {
            params {
                module_args = "--annotation-key cell_type"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/data/spatial.h5ad", checkIfExists: true),
                    file("${moduleDir}/tests/data/reference.h5ad", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
