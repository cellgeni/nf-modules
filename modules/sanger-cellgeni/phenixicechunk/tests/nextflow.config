includeConfig "../../../../tests/config/nextflow.config"

process {
    withName: PHENIXICECHUNK {
        ext.args = params.module_args
    }
}

// The Wave image runs as root, which would leave root-owned files in the nf-test work
// directory and break subsequent runs. phenix-icechunk needs no root privileges, so drop them.
docker.runOptions = '-u $(id -u):$(id -g)'
