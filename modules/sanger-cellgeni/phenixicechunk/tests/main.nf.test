nextflow_process {

    name "Test Process PHENIXICECHUNK"
    script "../main.nf"
    process "PHENIXICECHUNK"
    config "./nextflow.config"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "phenixicechunk"

    // Stub test only: there is no small, complete Harmony/Opera Phenix export available for
    // testing yet. The shared demo export (s3://spatial_demo_datasets/PerkinElmer/Hoechst__...)
    // has a trimmed Index.idx.xml without the <Maps> channel entries phenix-icechunk needs.
    // Add real-data tests once a suitable small dataset is available.

    test("perkinelmer - index xml - ome-tiff - stub") {

        options "-stub"

        when {
            params {
                module_args = "--ome-tiff ."
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('.'),
                    'Index.idx.xml'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
