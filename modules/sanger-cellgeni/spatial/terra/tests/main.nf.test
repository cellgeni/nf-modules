// nf-core modules test spatial/terra
nextflow_process {

    name "Test Process SPATIAL_TERRA"
    script "../main.nf"
    process "SPATIAL_TERRA"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "spatial"
    tag "spatial/terra"

    test("terra - h5ad") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'terra_demo.h5ad', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("terra - h5ad - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'terra_demo.h5ad', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
