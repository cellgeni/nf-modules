// nf-core modules test spatial/dot
nextflow_process {

    name "Test Process SPATIAL_DOT"
    script "../main.nf"
    process "SPATIAL_DOT"

    tag "modules"
    tag "modules_sangercellgeni"
    tag "spatial"
    tag "spatial/dot"

    test("dot -  h5ad") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'GBM_whole_ad_mini500_filtered.h5ad', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'AT400-BRA-0-ORG-1A-1-S17__tangram.h5ad', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("dot - h5ad - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'GBM_whole_ad_mini500_filtered.h5ad', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'AT400-BRA-0-ORG-1A-1-S17__tangram.h5ad', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
