nextflow_process {

    name "Test Process TANGRAM"
    script "../main.nf"
    process "TANGRAM"
    config "./nextflow.config"

    tag "modules"
    tag "modules_sanger-cellgeni"
    tag "tangram"

    test("tangram - cells mode - stub") {

        options "-stub"

        when {
            process {
                """
                def sc_data = file("scrna.h5ad")
                sc_data.text = "stub"

                def sp_data = file("spatial.h5ad")
                sp_data.text = "stub"

                input[0] = [ [ id: 'test_sample' ], sc_data, sp_data, [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
