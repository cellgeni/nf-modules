nextflow_process {

    name "Test Process SEGTRAQ_REGIONSIMILARITY"
    script "../main.nf"
    process "SEGTRAQ_REGIONSIMILARITY"
    config "./nextflow.config"

    tag "modules"
    tag "modules_sanger-cellgeni"
    tag "modules_sangercellgeni"
    tag "segtraq"
    tag "segtraq/regionsimilarity"

    test("segtraq_regionsimilarity - A02_4xHipSci sdata") {

        when {
            process {
                """
                input[0] = [
                    [ id:'A02_4xHipSci' ],
                    file(params.modules_testdata_base_path + 'spatialdata_tests/A02_4xHipSci.sdata/', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.obs[0][1]).exists() },
                { assert file(process.out.obs[0][1]).size() > 0 }
            )
        }

    }

    test("segtraq_regionsimilarity - A02_4xHipSci sdata - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'A02_4xHipSci' ],
                    file(params.modules_testdata_base_path + 'spatialdata_tests/A02_4xHipSci.sdata/', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
